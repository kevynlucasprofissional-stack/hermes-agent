 def test_navigation_blocks_cloud_metadata_floor():
     args = {"url": "http://169.254.169.254/latest/meta-data/iam/security-credentials/"}
     with pytest.raises(bw.WorkstationBrowserError, match="cloud metadata"):
         bw._validate_navigation(args)
+
+
+@pytest.mark.parametrize("url", [
+    "file:///C:/private.txt",
+    "javascript:alert(1)",
+    "data:text/html,unsafe",
+    "blob:https://example.org/opaque",
+    "filesystem:https://example.org/persistent/a",
+])
+def test_explicit_nonweb_url_rejected_before_controller(monkeypatch, url):
+    """Explicit non-web input must not reach controller or search transport."""
+    def forbidden_transport(*args, **kwargs):
+        pytest.fail("forbidden navigation reached controller transport")
+
+    monkeypatch.setattr(bw, "_request_json", forbidden_transport)
+    with pytest.raises(bw.WorkstationBrowserError) as exc:
+        bw._dispatch("browser_navigate", {"url": url}, model_facing=True)
+    assert exc.value.error_code == "FORBIDDEN_DESTINATION"
+    assert exc.value.state_changed is False
+
+
+@pytest.mark.parametrize("source, expected", [
+    ("about:blank", "about:blank"),
+    ("localhost:3000/health", "http://localhost:3000/health"),
+    ("search cats", "https://duckduckgo.com/?q=search+cats"),
+])
+def test_existing_search_and_local_navigation_are_unchanged(source, expected):
+    args = {"url": source}
+    bw._validate_navigation(args)
+    assert args["url"] == expected
 
 
