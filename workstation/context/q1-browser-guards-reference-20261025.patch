--- a/tools/browser_workstation.py
+++ b/tools/browser_workstation.py
@@ -601,8 +601,21 @@
     raw = str(args.get("url") or "").strip()
     if not raw:
         raise WorkstationBrowserError("browser_navigate requires a URL or search target")
 
+    # Explicit non-web schemes are not search terms: the existing normalizer
+    # otherwise turns a local file URL into an external DuckDuckGo query.
+    if urlsplit(raw).scheme.lower() in {
+        "file", "javascript", "data", "blob", "filesystem",
+    }:
+        raise WorkstationBrowserError(
+            "Navigation blocked: explicit non-web URL scheme",
+            error_code="FORBIDDEN_DESTINATION",
+            retryable=False,
+            state_changed=False,
+            recommended_action="CORRECT_ARGUMENTS",
+        )
+
     # Preserve Hermes' browser security floor even though Workstation routing
     # runs before the legacy browser_navigate implementation. Search text is
     # checked before it can become a DuckDuckGo query, so recognizable secrets
     # never leave the machine through a search URL.
