      "id": "resolve_board",
      "tool": "trello_create_card",
      "args": {},
      "expect": {
        "ok": true
      }
    }
  ],
  "steps": [
    {
      "id": "create",
      "tool": "trello_create_card",
      "args": {
        "board": "$setup.resolve_board.board_id",
        "id": "$item.id"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "id": "verify",
      "tool": "trello_verify_card",
      "verifies": [
